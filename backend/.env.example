DATABASE_URL=sqlite:///./fireflies.db
CORS_ORIGINS=["http://localhost:3000"]

# AI provider: none | openai | claude
#   none   -> offline heuristics (no network, no key)
#   openai -> any OpenAI-compatible API. Groq by default; for Ollama use
#             LLM_BASE_URL=http://localhost:11434/v1 and LLM_MODEL=llama3.2
#   claude -> Anthropic API (set ANTHROPIC_API_KEY)
LLM_PROVIDER=none
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=

# Abuse protection for public deployments; over budget, requests use the offline fallback.
LLM_REQUESTS_PER_HOUR_PER_CLIENT=20
LLM_REQUESTS_PER_DAY=300
